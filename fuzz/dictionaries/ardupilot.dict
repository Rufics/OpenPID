# libFuzzer dictionary for the ArduPilot DataFlash target: packet header,
# the self-describing FMT block and the message names the profile maps.

# packet head bytes and the FMT definition of FMT itself (type 128, length 89)
"\xa3\x95"
"\xa3\x95\x80"
"\xa3\x95\x80\x80\x59FMT\x00BBnNZ\x00"

# message names
"FMT"
"FMTU"
"UNIT"
"MULT"
"PARM"
"MSG"
"IMU"
"RATE"
"PIDR"
"PIDP"
"PIDY"
"RCOU"
"RCIN"
"CTUN"
"ATT"
"BAT"
"CURR"
"ESC"
"ISBH"
"ISBD"
"MODE"
"EV"
"VER"

# format strings and column names
"QBBnNZ"
"QffffffIIfBBHH"
"Qffffffff"
"TimeUS"
"TimeMS"
"GyrX"
"AccX"
"RDes"
"Tar"
"Err"
"ThO"
"RPM"
"Name"
"Value"
"Instance"

# parameters the profile reads
"ATC_RAT_RLL_P"
"ATC_RAT_RLL_D"
"RATE_RLL_P"
"RLL_RATE_P"
"SCHED_LOOP_RATE"
"INS_GYRO_RATE"
"INS_GYRO_FILTER"
"INS_HNTCH_ENABLE"
"INS_HNTCH_MODE"
"INS_LOG_BAT_MASK"
"INS_LOG_BAT_OPT"
"MOT_PWM_MIN"
"MOT_PWM_MAX"
"FRAME_CLASS"

# interesting lengths, counts and values
"\x00"
"\xff"
"\x01"
"\x59"
"\x80"
"\x7f"
"\xff\xff"
"\x00\x00\x00\x80"
"\xff\xff\xff\x7f"
"\xff\xff\xff\xff\xff\xff\xff\xff"
