# libFuzzer dictionary for the Blackbox targets: the structural knowledge of
# the former mutation harness (frame markers, header keys, interesting
# numbers) so the fuzzer reaches the header and frame logic without guessing.
# Format: one quoted token per line; \xNN escapes bytes.

# log start and header lines
"H Product:Blackbox flight data recorder by Nicholas Sherlock"
"H Product:"
"H Data version:2"
"H Data version:"
"H I interval:"
"H P interval:"
"H P ratio:"
"H Firmware type:Cleanflight"
"H Firmware revision:Betaflight "
"H Firmware revision:EmuFlight "
"H Firmware revision:Rotorflight "
"H Firmware revision:INAV "
"H Field I name:"
"H Field I signed:"
"H Field I predictor:"
"H Field I encoding:"
"H Field P predictor:"
"H Field P encoding:"
"H Field S name:"
"H Field S signed:"
"H Field S predictor:"
"H Field S encoding:"
"H Field G name:"
"H Field H name:"
"H looptime:"
"H gyro_scale:"
"H motorOutput:"
"H minthrottle:"
"H vbatref:"
"H debug_mode:"
"H motor_poles:"
"H blackbox_high_resolution:"
"H fields_disabled_mask:"
"H pid_process_denom:"
"H gyro_sync_denom:"

# field names the profiles map
"loopIteration"
"time"
"axisP[0]"
"axisI[0]"
"axisD[0]"
"axisF[0]"
"rcCommand[3]"
"setpoint[0]"
"gyroADC[0]"
"gyroUnfilt[0]"
"accSmooth[0]"
"motor[0]"
"eRPM[0]"
"debug[0]"
"vbatLatest"
"amperageLatest"
"flightModeFlags"
"stateFlags"
"failsafePhase"

# frame markers and separators
"I"
"P"
"S"
"E"
"G"
"H"
"\x0a"
","
":"
"\x00"
"\xff"

# event frames: type byte and the end-of-log marker
"E\x00"
"E\x0d"
"E\x0e"
"E\x0f"
"E\x1e"
"E\xff"
"End of log\x00"

# interesting numbers for header values and lists
"0"
"1"
"-1"
"2"
"7"
"8"
"31"
"32"
"63"
"64"
"127"
"128"
"255"
"256"
"32767"
"32768"
"65535"
"65536"
"2147483647"
"2147483648"
"-2147483648"
"-2147483649"
"4294967295"
"4294967296"
"9223372036854775807"
"18446744073709551615"
"18446744073709551616"
"NaN"
"inf"
"-0"
"1e308"
",,"
",-1,"

# Rotorflight events: governor / rescue / airborne state (1 byte), custom data
# (length + bytes) and a NUL-terminated custom string
"E\x32"
"E\x33"
"E\x34"
"E\x64\x03abc"
"E\x65custom\x00"
"E\x65"
